        "subtotal": "99.99", "discount": "0.00", "taxable": "99.99",
        "cgst": "2.50", "sgst": "2.50", "igst": "0.00", "total": "104.99"
      }
    },
    {
      "name": "a line discount comes off before tax",
      "supplier_state": "07", "place_of_supply": "07",
