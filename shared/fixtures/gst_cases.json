      "expected": {
        "supply": "inter", "state_tax_label": "SGST",
        "lines": [{ "amount": "1000.00", "taxable_value": "1000.00", "cgst": "0.00", "sgst": "0.00", "igst": "180.00" }],
        "subtotal": "1000.00", "discount": "0.00", "taxable": "1000.00",
