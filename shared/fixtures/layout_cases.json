{
  "_comment": "Layout Algorithm (docs/03-schema.md). row_h = ceil(fontSize * lineHeight) + 2 * rowPadding; the table's designed height is header + 3 sample rows. Elements whose top is at or below the table's designed bottom move by delta. Run by frontend/tests/sharedFixtures.test.ts (lib/layout.ts); Phase 5's layout_service.py must pass the same cases. Expected positions list every element as {y, height}.",
  "templates": {
    "thermal": {
      "page": { "preset": "thermal80", "width": 302, "height": 400, "heightMode": "auto", "background": "#FFFFFF", "margin": 12 },
      "elements": [
        { "id": "title", "type": "text", "x": 12, "y": 12, "width": 278, "height": 32 },
        { "id": "table", "type": "items_table", "x": 12, "y": 60, "width": 278, "height": 96, "props": { "fontSize": 12, "lineHeight": 1.3, "rowPadding": 4 } },
        { "id": "side_note", "type": "text", "x": 200, "y": 100, "width": 90, "height": 20 },
        { "id": "rule", "type": "divider", "x": 12, "y": 156, "width": 278, "height": 8 },
        { "id": "totals", "type": "totals", "x": 120, "y": 168, "width": 170, "height": 90 },
        { "id": "qr", "type": "qr", "x": 100, "y": 270, "width": 100, "height": 100 }
      ]
    },
    "a5": {
      "page": { "preset": "a5", "width": 559, "height": 794, "heightMode": "fixed", "background": "#FFFFFF", "margin": 24 },
      "elements": [
        { "id": "title", "type": "text", "x": 24, "y": 24, "width": 300, "height": 40 },
        { "id": "table", "type": "items_table", "x": 24, "y": 100, "width": 500, "height": 96, "props": { "fontSize": 12, "lineHeight": 1.3, "rowPadding": 4 } },
        { "id": "totals", "type": "totals", "x": 300, "y": 220, "width": 224, "height": 90 }
      ]
    },
    "no_table": {
      "page": { "preset": "thermal80", "width": 302, "height": 400, "heightMode": "auto", "background": "#FFFFFF", "margin": 12 },
      "elements": [
        { "id": "title", "type": "text", "x": 12, "y": 12, "width": 278, "height": 32 },
        { "id": "totals", "type": "totals", "x": 120, "y": 168, "width": 170, "height": 90 }
      ]
    },
    "big_rows": {
      "page": { "preset": "thermal80", "width": 302, "height": 500, "heightMode": "auto", "background": "#FFFFFF", "margin": 12 },
      "elements": [
        { "id": "table", "type": "items_table", "x": 12, "y": 20, "width": 278, "height": 144, "props": { "fontSize": 16, "lineHeight": 1.5, "rowPadding": 6 } },
        { "id": "totals", "type": "totals", "x": 120, "y": 180, "width": 170, "height": 90 }
      ]
    }
  },
  "cases": [
    {
      "name": "auto page, 3 items (the design) changes nothing",
      "template": "thermal",
      "n_rows": 3,
      "expected": {
        "delta": 0, "page_height": 400, "error": null,
        "positions": {
          "title": { "y": 12, "height": 32 }, "table": { "y": 60, "height": 96 }, "side_note": { "y": 100, "height": 20 },
          "rule": { "y": 156, "height": 8 }, "totals": { "y": 168, "height": 90 }, "qr": { "y": 270, "height": 100 }
        }
      }
    },
    {
      "name": "auto page, 6 items push everything below the table down and grow the page",
      "template": "thermal",
      "n_rows": 6,
      "expected": {
        "delta": 72, "page_height": 472, "error": null,
        "positions": {
          "title": { "y": 12, "height": 32 }, "table": { "y": 60, "height": 168 }, "side_note": { "y": 100, "height": 20 },
          "rule": { "y": 228, "height": 8 }, "totals": { "y": 240, "height": 90 }, "qr": { "y": 342, "height": 100 }
        }
      }
    },
    {
      "name": "auto page, 1 item pulls content up and shrinks the page",
      "template": "thermal",
      "n_rows": 1,
      "expected": {
        "delta": -48, "page_height": 352, "error": null,
        "positions": {
          "title": { "y": 12, "height": 32 }, "table": { "y": 60, "height": 48 }, "side_note": { "y": 100, "height": 20 },
          "rule": { "y": 108, "height": 8 }, "totals": { "y": 120, "height": 90 }, "qr": { "y": 222, "height": 100 }
        }
      }
    },
    {
      "name": "auto page, no items leaves just the header row",
      "template": "thermal",
      "n_rows": 0,
      "expected": {
        "delta": -72, "page_height": 328, "error": null,
        "positions": {
          "title": { "y": 12, "height": 32 }, "table": { "y": 60, "height": 24 }, "side_note": { "y": 100, "height": 20 },
          "rule": { "y": 84, "height": 8 }, "totals": { "y": 96, "height": 90 }, "qr": { "y": 198, "height": 100 }
        }
      }
    },
    {
      "name": "fixed page never pulls content up",
      "template": "a5",
      "n_rows": 1,
      "expected": {
        "delta": 0, "page_height": 794, "error": null,
        "positions": { "title": { "y": 24, "height": 40 }, "table": { "y": 100, "height": 96 }, "totals": { "y": 220, "height": 90 } }
      }
    },
    {
      "name": "fixed page pushes down while content fits",
      "template": "a5",
      "n_rows": 10,
      "expected": {
        "delta": 168, "page_height": 794, "error": null,
        "positions": { "title": { "y": 24, "height": 40 }, "table": { "y": 100, "height": 264 }, "totals": { "y": 388, "height": 90 } }
      }
    },
    {
      "name": "fixed page overflowing its bottom margin is CONTENT_OVERFLOW",
      "template": "a5",
      "n_rows": 30,
      "expected": {
        "delta": 648, "page_height": 794, "error": "CONTENT_OVERFLOW",
        "positions": { "title": { "y": 24, "height": 40 }, "table": { "y": 100, "height": 744 }, "totals": { "y": 868, "height": 90 } }
      }
    },
    {
      "name": "without an items table nothing moves",
      "template": "no_table",
      "n_rows": 5,
      "expected": {
        "delta": 0, "page_height": 400, "error": null,
        "positions": { "title": { "y": 12, "height": 32 }, "totals": { "y": 168, "height": 90 } }
      }
    },
    {
      "name": "row height follows the table's font size, line height and padding",
      "template": "big_rows",
      "n_rows": 5,
      "expected": {
        "delta": 72, "page_height": 572, "error": null,
        "positions": { "table": { "y": 20, "height": 216 }, "totals": { "y": 252, "height": 90 } }
      }
    }
  ]
}
