# Copy to .env for local development.

# "development" (the default) accepts the built-in dev SECRET_KEY. Anywhere else
# set APP_ENV=production and a SECRET_KEY of at least 32 random characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_ENV=development
SECRET_KEY=supersecretkey-dev-from-env

# Folder with WeasyPrint's GTK/Pango DLLs (Windows). Not needed for the standard
# MSYS2 install at C:\msys64, which is found automatically.
# WEASYPRINT_DLL_DIRECTORIES=C:\msys64\mingw64\bin

# "Sign in with Google": OAuth client ID (Web application) from the Google
# Cloud console; leave empty to hide the button
GOOGLE_CLIENT_ID=

# Websites allowed to call the API (comma-separated); "*" allows any
# CORS_ORIGINS=https://receipt-studio-5tp.pages.dev

# Forgot password emails through Brevo's API (free hosts block SMTP). Without
# them, development writes the reset link to the server log
# PUBLIC_APP_URL=http://localhost:5173
# BREVO_API_KEY=
# EMAIL_FROM=

# Error alerts (sentry.io project DSN); empty: off
# SENTRY_DSN=

# Accounts that can read feedback in the app (comma-separated emails)
# ADMIN_EMAILS=
