# Copy to .env for local development.

# "development" (the default) accepts the built-in dev SECRET_KEY. Anywhere else
# set APP_ENV=production and a SECRET_KEY of at least 32 random characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_ENV=development
SECRET_KEY=supersecretkey-dev-from-env

# Folder with WeasyPrint's GTK/Pango DLLs (Windows). Not needed for the standard
# MSYS2 install at C:\msys64, which is found automatically.
# WEASYPRINT_DLL_DIRECTORIES=C:\msys64\mingw64\bin
