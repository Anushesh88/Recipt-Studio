# Backend URL the frontend talks to (copy to .env.local to override). Locally
# it's http://localhost:8000; on Cloudflare Pages (or Netlify) set it to
# your Render URL, e.g. VITE_API_URL=https://receipt-studio-api.onrender.com
VITE_API_URL=http://localhost:8000

# Error alerts (sentry.io React project DSN), read when the site is built; empty: off
# VITE_SENTRY_DSN=
